{
  "name": "LEAAID Learning Harness Workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci && npm run qa",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "LEAAID Mastery Path",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  },
  "remoteUser": "node"
}
