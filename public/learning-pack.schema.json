{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaaid-mastery-path.nexus-8198.chatgpt.site/learning-pack.schema.json",
  "title": "Learning Harness Course Pack",
  "description": "Target-state interoperability contract for a source-bounded specialist course pack. Publishing this contract does not enable runtime loading of third-party packs.",
  "type": "object",
  "required": ["schemaVersion", "id", "group", "title", "version", "modules", "sources", "controls"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "group": {"type": "string", "minLength": 2, "maxLength": 48},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 32},
    "modules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "questionBank"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "questionBank": {"type": "string"}}, "additionalProperties": false}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "version", "authority"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "version": {"type": "string"}, "authority": {"enum": ["normative", "policy", "guidance", "commentary"]}}, "additionalProperties": false}},
    "controls": {"type": "object", "required": ["masteryPercent", "answerDisclosure", "validation"], "properties": {"masteryPercent": {"type": "integer", "minimum": 1, "maximum": 100}, "answerDisclosure": {"const": "after_submission_only"}, "validation": {"const": "authored_key"}}, "additionalProperties": false},
    "achievements": {"type": "array", "items": {"type": "object", "required": ["id", "title", "gate"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "gate": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
