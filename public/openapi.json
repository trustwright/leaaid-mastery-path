{
  "openapi": "3.1.0",
  "info": {"title": "LEAAID Mastery Path Agent", "version": "1.0.0", "description": "Invitation-controlled, source-grounded LEAAID coaching and sequential training challenges."},
  "servers": [{"url": "https://leaaid-mastery-path.nexus-8198.chatgpt.site"}],
  "paths": {"/api/agent": {
    "get": {"operationId": "describeLEAAIDProgram", "summary": "Describe the curriculum and agent capabilities", "responses": {"200": {"description": "Program description"}}},
    "post": {"operationId": "operateLEAAIDAgent", "summary": "Coach, launch, answer, or resume a LEAAID training session", "security": [{"InvitationKey": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentRequest"}}}}, "responses": {"200": {"description": "Agent action result"}, "400": {"description": "Invalid action"}, "401": {"description": "Invitation key required"}, "409": {"description": "Sequential mastery gate not satisfied"}}}
  }},
  "components": {
    "securitySchemes": {"InvitationKey": {"type": "apiKey", "in": "header", "name": "X-LEAAID-Access-Key"}},
    "schemas": {"AgentRequest": {"type": "object", "required": ["action"], "properties": {"action": {"type": "string", "enum": ["describe_program", "create_session", "coach", "launch_multi_agent_training", "validate_training_response", "launch_training_challenge", "submit_answer", "launch_applied_lab", "submit_lab_choice", "launch_premier_challenge", "get_session"]}, "session_id": {"type": "string"}, "module_id": {"type": "integer", "minimum": 1, "maximum": 5}, "goal": {"type": "string", "enum": ["understand", "apply", "prepare"]}, "option_index": {"type": "integer", "minimum": 0, "maximum": 3}}}}
  }
}
